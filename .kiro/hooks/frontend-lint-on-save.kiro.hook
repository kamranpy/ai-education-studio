{
  "enabled": true,
  "name": "Frontend Lint on Save",
  "description": "Runs ESLint with auto-fix on TypeScript and React files whenever they are saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run lint -- --fix"
  }
}