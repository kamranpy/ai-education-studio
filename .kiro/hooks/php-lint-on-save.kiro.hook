{
  "enabled": true,
  "name": "PHP Lint on Save",
  "description": "Runs Laravel Pint to auto-format PHP files whenever one is saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.php"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "composer pint"
  }
}